{
  "name": "tana-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Tana Studio desktop scene and video editor",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 1420",
    "predev": "node scripts/build-editor.mjs",
    "prebuild": "node scripts/build-editor.mjs",
    "build": "next build --webpack",
    "build:desktop": "npm run build",
    "check": "tsc --noEmit",
    "test": "node --test editor/*.test.mjs tests/*.test.mjs",
    "test:ui": "node tests/studio-ui.mjs",
    "tauri": "node scripts/tauri.mjs",
    "prepare:converter": "node scripts/prepare-converter.mjs",
    "test:converter": "src-tauri/converter/runtime/bin/python3 -I tests/model-converter.py"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@tauri-apps/api": "2.12.0",
    "fflate": "^0.8.3",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rixse": "file:vendor/rixse",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "playwright": "1.63.0",
    "typescript": "^5.9"
  }
}
